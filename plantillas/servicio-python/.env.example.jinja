# Variables del servicio. Las de otros servicios van como referencias de la
# plataforma (por ejemplo, en Railway, ${{servicio.VARIABLE}}), nunca con el valor copiado.
LOG_LEVEL=INFO
PORT=8000
[%- if usa_postgres %]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/[[ paquete ]]
[%- endif %]
[%- if variables %]

# Traídas del catálogo por las dependencias declaradas (las comentadas, revisarlas):
[%- for v in variables %]
# [[ v.fuente ]][% if v.nota is defined %] ([[ v.nota ]])[% endif %]
[% if v.nota is defined %]# [% endif %][[ v.linea ]]
[%- endfor %]
[%- endif %]
