[project]
name = "[[ nombre ]]"
version = "0.1.0"
description = "[[ descripcion | replace('\\', '\\\\') | replace('"', '\\"') ]]"
readme = "README.md"
requires-python = ">=3.12"
dependencies = [
    "fastapi>=0.115",
    "uvicorn>=0.32",
    "pydantic-settings>=2.6",
[%- if usa_postgres %]
    "psycopg[binary,pool]>=3.2",
[%- endif %]
]

[project.optional-dependencies]
dev = [
    "httpx>=0.27",
    "mypy>=1.13",
    "pytest>=8.3",
    "ruff>=0.8",
]

[project.scripts]
[[ nombre ]] = "[[ paquete ]].main:main"

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/[[ paquete ]]"]

[tool.ruff]
line-length = 100
target-version = "py312"

[tool.ruff.lint]
select = ["E", "F", "I", "UP", "B", "S"]
ignore = ["S101"]

[tool.ruff.lint.per-file-ignores]
# El docstring es la descripción del catálogo, que puede ser larga.
"src/*/__init__.py" = ["E501"]

[tool.mypy]
python_version = "3.12"
strict = true
mypy_path = "src"

[tool.pytest.ini_options]
testpaths = ["tests"]
